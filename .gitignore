# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ─── Airflow (generated at runtime) ─────────────────────────────────────────
logs/*
!logs/.gitkeep
airflow.cfg
airflow.db
config/airflow.cfg
webserver_config.py
standalone_admin_password.txt

# ─── dbt artefacts (regenerated by `dbt build` / Cosmos) ────────────────────
include/dbt/target/
include/dbt/dbt_packages/
include/dbt/logs/
include/dbt/.user.yml

# ─── DuckDB local warehouse (rebuilt by the pipeline, never committed) ──────
*.duckdb
*.duckdb.wal
include/data/*.duckdb

# ─── Staging zone (Parquet scratch files, generated by the ingestion step) ──
include/data/_staging/

# ─── Secrets & local environment ────────────────────────────────────────────
.env
secrets/
sa-*.json
service-account*.json
*-key.json

# ─── OS / IDE noise ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
site/
