# ============================================================================
# Environment configuration — copy to `.env` before running `docker compose`.
#
#   cp .env.example .env        (Linux / macOS / Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# `.env` is git-ignored. Never commit real credentials.
# ============================================================================

# ─── Docker / Airflow runtime ───────────────────────────────────────────────
# On Linux set this to your host UID (`id -u`) so mounted files are not
# created as root. On Windows / macOS the default 50000 is fine.
AIRFLOW_UID=50000

# Name of the image built from the local Dockerfile.
AIRFLOW_IMAGE_NAME=airflow-bigquery:local

# Base path mounted into the containers (leave as ".").
AIRFLOW_PROJ_DIR=.

# Initial Airflow web UI admin account.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Fernet key used to encrypt Connections/Variables at rest.
# Empty is acceptable for local dev. Generate a real one for any shared env:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# ─── hr_pipeline — environment switch ───────────────────────────────────────
# "local"      -> DuckDB warehouse, no cloud credentials required.
# "production" -> Google BigQuery (see docs/production-gcp.md).
HR_ENV=local

# ─── Local profile (HR_ENV=local) ───────────────────────────────────────────
DUCKDB_PATH=/opt/airflow/include/data/warehouse.duckdb
HR_RAW_DATA_DIR=/opt/airflow/include/data/raw

# ─── dbt / Cosmos ───────────────────────────────────────────────────────────
DBT_PROJECT_DIR=/opt/airflow/include/dbt
DBT_PROFILES_DIR=/opt/airflow/include/dbt

# ─── Production profile (HR_ENV=production) — leave empty for local runs ─────
GCP_PROJECT=
BQ_LOCATION=EU
BQ_DATASET_RAW=raw_hr
# Path INSIDE the container to a mounted service-account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=
